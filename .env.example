# ---- Required ----------------------------------------------------------
SLACK_BOT_TOKEN=xoxb-...
SLACK_CHANNEL=C08AB12CD          # channel ID is safest - some dashboards
                                 # strip everything after a "#", turning
                                 # "#yc-alerts" into an empty value.
                                 # Copy link on the channel gives the ID.

# ---- Required once you publish on Pond ---------------------------------
ADMIN_TOKEN=                      # any random string; guards POST /admin/scan
POND_ACCESS_KEY=                  # issued by Pond after it reads /manifest

# ---- Optional: paid / fragile sources ----------------------------------
APIFY_TOKEN=                      # enables LinkedIn + the X keyword tier
X_KEYWORD_TIER=off                # off | apify
METERED_ON_REQUEST_ONLY=          # true | false; overrides config.yml.
                                  # true = the paid sources run only when Pond
                                  # invokes the agent, never on the timer.

# ---- Optional: tuning --------------------------------------------------

# ---- Optional: model judgment (OFF by default, no API key needed) ------
# Set to "auto" and supply a key to add LLM judgment on top of the rules
# engine. Requires: pip install -r requirements-llm.txt
LLM_MODE=off                      # off | auto | always
ANTHROPIC_API_KEY=

DATABASE_PATH=data/monitor.db
DAILY_SPEND_CAP_USD=2.00
LOG_LEVEL=INFO
